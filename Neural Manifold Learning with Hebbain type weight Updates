function fig_sensitivity_heatmaps(results, sysNames)
    figure('Color','w','Name','Sensitivity_Heatmaps','Position',[50,50,1200,500]);
    
    alpha_vals = results.alpha_WD;
    n_systems = length(results.systems);
    
    for si = 1:n_systems
        subplot(1, n_systems, si);
        
        iter_data = results.iterations(:, :, si);
        iter_data(isnan(iter_data)) = max(iter_data(:));
        
        imagesc(alpha_vals, alpha_vals, iter_data);
        set(gca, 'YDir', 'normal');
        colorbar;
        colormap('hot');
        
        xlabel('\alpha_{WD} (Manifold Damping)','FontSize',14,'FontWeight','bold');
        ylabel('\alpha_{ID} (Integral Bias)','FontSize',14,'FontWeight','bold');
        title(sprintf('Iterations - %s', results.systems{si}),'FontSize',16,'FontWeight','bold');
        
        for wi = 1:length(alpha_vals)
            for ii = 1:length(alpha_vals)
                val = results.iterations(wi, ii, si);
                if ~isnan(val) && val > 0
                    text(wi, ii, sprintf('%.0f', val), ...
                        'HorizontalAlignment','center','VerticalAlignment','middle', ...
                        'FontSize',10,'Color','w','FontWeight','bold');
                end
            end
        end
        
        set(gca,'FontSize',12,'FontWeight','bold','LineWidth',2);
    end
    
    sgtitle('Hyperparameter Sensitivity: Iterations vs \alpha_{WD} and \alpha_{ID} (MAX_ITER=400)', ...
        'FontSize',18,'FontWeight','bold');
    exportgraphics(gcf,'Fig_Sensitivity_Heatmaps.png','Resolution',300);
    fprintf('  Saved: Fig_Sensitivity_Heatmaps.png\n');
end

function fig_sensitivity_iterations(results, sysNames)
    figure('Color','w','Name','Sensitivity_Iterations','Position',[50,50,1200,500]);
    
    alpha_vals = results.alpha_WD;
    n_systems = length(results.systems);
    colors = {'b-', 'r-', 'g-', 'm-', 'k-'};
    
    for si = 1:n_systems
        subplot(1, n_systems, si);
        hold on;
        
        for ii = 1:length(alpha_vals)
            iter_data = squeeze(results.iterations(:, ii, si));
            plot(alpha_vals, iter_data, colors{ii}, 'LineWidth', 2.5, ...
                'DisplayName', sprintf('\\alpha_{ID}=%.2f', alpha_vals(ii)));
        end
        
        xlabel('\alpha_{WD} (Manifold Damping)','FontSize',14,'FontWeight','bold');
        ylabel('Iterations to Convergence','FontSize',14,'FontWeight','bold');
        title(sprintf('%s', results.systems{si}),'FontSize',16,'FontWeight','bold');
        legend('Location','best','FontSize',10);
        grid on;
        set(gca,'FontSize',12,'FontWeight','bold','LineWidth',2);
        xlim([min(alpha_vals), max(alpha_vals)]);
        ylim([0, 405]);
        yline(400, '--k', 'MAX_ITER=400', 'LineWidth', 2);
    end
    
    sgtitle('Convergence Iterations vs \alpha_{WD} for Different \alpha_{ID}', ...
        'FontSize',18,'FontWeight','bold');
