function [nr, nc] = subplot_grid(nSys)
    nc = ceil(sqrt(nSys));
    nr = ceil(nSys / nc);
end

function labs = subplot_label_set(nSys)
    letters = 'a':'z';
    labs = cell(1, nSys);
    for i = 1:nSys
        labs{i} = sprintf('(%s)', letters(i));
    end
end

%==========================================================================
%  CORE WLS METHODS
%==========================================================================
function [x, hist] = se_wls_correct(z, meas, Ybus, Yf, mpc, n, nm, Rd, x0, par)
    x    = clip_x(x0, n);
    hist = init_hist(par.MAX_ITER);
    hist.x_final = x;
    kappa = par.kappa;

    for k = 1:par.MAX_ITER
        [~,~,J,g,G] = compute_all_general(x, z, meas, Ybus, Yf, mpc, n, nm, Rd);

        hist.J(k)  = J;
        hist.gn(k) = norm(g, inf);

        if rcond(G) < 1e-14
            dx = g * kappa;
        else
            dx = -(G \ g);
        end
        dx(~isfinite(dx)) = sign(dx(~isfinite(dx)) + eps) * kappa;

        hist.step(k) = norm(dx, inf);
        x = clip_x(x + dx, n);

        if hist.gn(k) <= par.tol && hist.step(k) <= par.tol_dx
            hist = trim_hist(hist, k, 'CONVERGED');
            hist.conv  = true;
            hist.x_final = x;
            return;
        end
    end

    hist = trim_hist(hist, par.MAX_ITER, 'MAX_ITER');
    hist.x_final = x;
end

function [x, hist] = se_wls_lm_correct(z, meas, Ybus, Yf, mpc, n, nm, Rd, x0, par)
    x    = clip_x(x0, n);
    hist = init_hist(par.MAX_ITER);
    hist.x_final = x;
    Nst   = 2*n - 1;
    kappa = par.kappa;

    for k = 1:par.MAX_ITER
        [~,~,J,g,G] = compute_all_general(x, z, meas, Ybus, Yf, mpc, n, nm, Rd);

        hist.J(k)  = J;
        hist.gn(k) = norm(g, inf);

        if kappa > 1e3
            lambda = 1e-12 * max(abs(diag(G)));
        else
            lambda = max(1e-6, 1e-4 * trace(G) / Nst);
        end

        A  = G + lambda * eye(size(G));
        dx = -(A \ g);
        if any(~isfinite(dx))
            dx = g * kappa;
        end

        hist.step(k) = norm(dx, inf);
        x = clip_x(x + dx, n);

        if hist.gn(k) <= par.tol && hist.step(k) <= par.tol_dx
            hist = trim_hist(hist, k, 'CONVERGED');
            hist.conv    = true;
            hist.x_final = x;
            return;
        end
    end

    hist = trim_hist(hist, par.MAX_ITER, 'MAX_ITER');
    hist.x_final = x;
end

%==========================================================================
%  BUILD FROM MATPOWER
%==========================================================================
function mpc = build_from_matpower(case_name)
    raw = loadcase(case_name);
    mpopt = mpoption('verbose', 0, 'out.all', 0, ...
                     'pf.alg', 'NR', 'pf.tol', 1e-10, ...
                     'pf.nr.max_it', 50, 'pf.enforce_q_lims', 0);
    [solved, success] = runpf(raw, mpopt);
    
    if ~(logical(success) && isfield(solved, 'success') && solved.success)
        error('MATPOWER power flow failed for %s', case_name);
    end

    solved = ext2int(solved);
    n = size(solved.bus, 1);
    
    ref_bus = find(solved.bus(:,2) == 3, 1, 'first');
    if isempty(ref_bus), ref_bus = 1; end
    
    order = [ref_bus; setdiff((1:n)', ref_bus, 'stable')];
    old_to_new = zeros(n,1);
    old_to_new(order) = (1:n)';
    
    solved.bus = solved.bus(order,:);
    solved.bus(:,1) = (1:n)';
    if isfield(solved, 'gen')
        solved.gen(:,1) = old_to_new(solved.gen(:,1));
    end
    solved.branch(:,1) = old_to_new(solved.branch(:,1));
    solved.branch(:,2) = old_to_new(solved.branch(:,2));
    solved.branch = solved.branch(solved.branch(:,11) ~= 0, :);

    Pg = zeros(n,1); Qg = zeros(n,1);
    if isfield(solved, 'gen')
        online = find(solved.gen(:,8) > 0);
        for k = online(:)'
            b = solved.gen(k,1);
            Pg(b) = Pg(b) + solved.gen(k,2) / solved.baseMVA;
            Qg(b) = Qg(b) + solved.gen(k,3) / solved.baseMVA;
        end
    end

    internal_type = 3 * ones(n,1);
    internal_type(solved.bus(:,2) == 2) = 2;
    internal_type(solved.bus(:,2) == 3) = 1;

    mpc.bus = [(1:n)', internal_type, solved.bus(:,3)/solved.baseMVA, ...
               solved.bus(:,4)/solved.baseMVA, Pg, Qg, solved.bus(:,8)];
    
    tap = solved.branch(:,9); tap(tap == 0) = 1;
    mpc.branch = [solved.branch(:,1), solved.branch(:,2), ...
                  solved.branch(:,3), solved.branch(:,4), ...
                  solved.branch(:,5), tap];
    mpc.n = n;
end

