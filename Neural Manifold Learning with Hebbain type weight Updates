%==========================================================================
%  GENERAL COMPUTATION FUNCTIONS
%==========================================================================
function [r, H, J, g, G] = compute_all_general(x, z, meas, Ybus, Yf, mpc, n, nm, Rd)
    x  = clip_x(x, n);
    hx = h_meas_general(x, meas, Ybus, Yf, mpc, n);
    r  = hx - z;
    r(~isfinite(r)) = 0;
    H  = jac_H_general(x, meas, Ybus, Yf, mpc, n, nm);
    H(~isfinite(H)) = 0;
    G  = H' * bsxfun(@times, H, Rd);
    G  = 0.5*(G + G');
    g  = H' * (Rd .* r);
    J  = 0.5*(r' * (Rd .* r));
end

function hx = h_meas_general(x, meas, Ybus, Yf, mpc, n)
    theta = [0; x(1:n-1)];
    Vmag  = max(0.01, x(n:end));
    V     = Vmag .* exp(1i*theta);
    Sinj  = V .* conj(Ybus*V);
    If    = Yf*V;
    fr    = max(1, min(n, round(mpc.branch(:,1))));
    Sf    = V(fr) .* conj(If);
    hx    = [real(Sinj); imag(Sinj); Vmag; real(Sf); imag(Sf)];
    if strcmpi(meas.mode,'HYBRID')
        pb = meas.pmu_buses(:);
        hx = [hx; Vmag(pb).*cos(theta(pb)); Vmag(pb).*sin(theta(pb))];
    end
    hx(~isfinite(hx)) = 0;
end

function H = jac_H_general(x, meas, Ybus, Yf, mpc, n, nm)
    Nst   = numel(x);
    theta = [0; x(1:n-1)];
    Vmag  = max(0.01, x(n:end));
    V     = Vmag .* exp(1i*theta);
    nb_   = size(mpc.branch,1);
    fr    = max(1, min(n, round(mpc.branch(:,1))));
    H     = zeros(nm, Nst);
    Ibus  = Ybus*V;
    Vnorm = V ./ max(abs(V),1e-9);
    dSth  = 1i*diag(V)*conj(diag(Ibus) - Ybus*diag(V));
    dSVm  = diag(V)*conj(Ybus*diag(Vnorm)) + diag(Ibus)*conj(diag(Vnorm));
    H(1:n,       1:n-1)   = real(dSth(:,2:n));
    H(1:n,       n:2*n-1) = real(dSVm);
    H(n+1:2*n,   1:n-1)   = imag(dSth(:,2:n));
    H(n+1:2*n,   n:2*n-1) = imag(dSVm);
    H(2*n+1:3*n, n:2*n-1) = eye(n);
    If  = Yf*V;
    Vf  = V(fr);
    Sf  = Vf .* conj(If);
    Vfn = Vf ./ max(abs(Vf),1e-9);
    Cf  = sparse((1:nb_)',fr,1,nb_,n);
    dSf_Va = 1j*(diag(Sf)*Cf - diag(Vf)*conj(Yf*diag(V)));
    dSf_Vm = diag(conj(If).*Vfn)*Cf + diag(Vf)*conj(Yf*diag(Vnorm));
    rP_s = 3*n+1;       rP_e = min(3*n+nb_,nm);
    rQ_s = 3*n+nb_+1;   rQ_e = min(3*n+2*nb_,nm);
    nb_P = rP_e-rP_s+1; nb_Q = rQ_e-rQ_s+1;
    if nb_P > 0
        H(rP_s:rP_e,1:n-1)   = real(full(dSf_Va(1:nb_P,2:n)));
        H(rP_s:rP_e,n:2*n-1) = real(full(dSf_Vm(1:nb_P,:)));
    end
    if nb_Q > 0
        H(rQ_s:rQ_e,1:n-1)   = imag(full(dSf_Va(1:nb_Q,2:n)));
        H(rQ_s:rQ_e,n:2*n-1) = imag(full(dSf_Vm(1:nb_Q,:)));
    end
    if strcmpi(meas.mode,'HYBRID')
        pb = meas.pmu_buses(:);
        np = numel(pb);
        for k = 1:np
            bi  = pb(k);
            thi = bi-1;
            Vc  = n+bi-1;
            rr  = 3*n+2*nb_+k;
            ri  = 3*n+2*nb_+np+k;
            if rr > nm || ri > nm, continue; end
            if thi >= 1 && thi <= n-1
                H(rr,thi) = -Vmag(bi)*sin(theta(bi));
                H(ri,thi) =  Vmag(bi)*cos(theta(bi));
            end
            H(rr,Vc) = cos(theta(bi));
            H(ri,Vc) = sin(theta(bi));
        end
    end
    H(~isfinite(H)) = 0;
end

function [z, meas] = build_meas_general(mpc, Ybus, Yf, theta, Vmag, n, nb, pb, mode, ~)
    V    = Vmag .* exp(1i*theta);
    Sinj = V .* conj(Ybus*V);
    If   = Yf*V;
    fr   = max(1, min(n, round(mpc.branch(:,1))));
    Sf   = V(fr) .* conj(If);
    zs   = [real(Sinj); imag(Sinj); Vmag; real(Sf); imag(Sf)];

    sig_s = [0.02*ones(n,1); 0.025*ones(n,1); 0.006*ones(n,1); ...
             0.02*ones(nb,1); 0.025*ones(nb,1)];

    if strcmpi(mode,'HYBRID')
        np    = numel(pb);
        zp    = [Vmag(pb).*cos(theta(pb)); Vmag(pb).*sin(theta(pb))];
        z     = [zs; zp];
        sigma = [sig_s; 0.001*ones(2*np,1)];
    else
        z     = zs;
        sigma = sig_s;
        pb    = [];
    end

    meas.mode      = upper(mode);
    meas.n         = n;
    meas.nb        = nb;
    meas.pmu_buses = pb;
    meas.sigma     = sigma;
end

function val = sgi_general(g, G)
    g(~isfinite(g)) = 0;
    if isempty(G) || size(G,1) ~= numel(g)
        val = norm(g,inf); return;
    end
    d    = abs(diag(G));
    d(~isfinite(d)) = 0;
    pos  = d(d > 0);
    if isempty(pos), sf = 1; else sf = 1e-12*max(pos); end
    d    = max(d, sf);
    gs   = g ./ sqrt(d);
    gs(~isfinite(gs)) = 0;
    val  = norm(gs, inf);
end

function [Qp, Ds] = struct_precond_general(Q)
    d = abs(diag(Q));
    d = max(d, 1e-12*(max(d(d>0))+eps));
    Ds = 1 ./ sqrt(d);
    Ds(~isfinite(Ds)) = 1;
    Qp = bsxfun(@times, bsxfun(@times,Q,Ds), Ds');
    Qp = 0.5*(Qp+Qp');
end

function d = solve_svd_general(Q, g, tol)
    Q(~isfinite(Q)) = 0;
    g(~isfinite(g)) = 0;
    Q  = 0.5*(Q+Q');
    rc = rcond(Q);
    if ~isfinite(rc), rc = 0; end
    if rc < tol
        [U,S,V] = svd(Q,'econ');
        sv  = diag(S);
        if isempty(sv) || max(sv) <= 0
            d = -g; return;
        end
        dmp = 1e-6*max(sv);
        d   = -V*((sv./(sv.^2+dmp^2)).*(U'*g));
    else
        try
            [L,f] = chol(Q,'lower');
            if f == 0
                d = -(L'\(L\g));
            else
                d = -(Q\g);
            end
        catch
            d = -(Q\g);
        end
    end
    if any(~isfinite(d)), d = -g; end
end

function d = clip_step_general(d, n, par)
    d(~isfinite(d)) = 0;
    na = norm(d(1:min(n-1,end)), inf);
    if na > par.max_angle_step && na > 0
        d(1:n-1) = d(1:n-1) * (par.max_angle_step/na);
    end
    if numel(d) >= 2*n-1
        nv = norm(d(n:end), inf);
        if nv > par.max_volt_step && nv > 0
            d(n:end) = d(n:end) * (par.max_volt_step/nv);
        end
    end
end

function x = clip_x(x, n)
    x(~isfinite(x)) = 0;
    x(1:n-1) = max(-pi/2+1e-8, min(pi/2-1e-8, x(1:n-1)));
    x(n:end) = max(0.5+1e-8, min(1.5-1e-8, x(n:end)));
end

function [rmseV, rmseA] = rmse_state_full(x, Vtrue, Ttrue, n)
    if isempty(x) || any(~isfinite(x))
        rmseV = inf; rmseA = inf; return;
    end
    th    = [0; x(1:n-1)];
    Vm    = x(n:end);
    rmseV = sqrt(mean((Vm(:)-Vtrue(:)).^2));
    rmseA = sqrt(mean((th(:)-Ttrue(:)).^2));
end

function hist = init_hist(K)
    hist.J      = nan(K,1);
    hist.E      = nan(K,1);
    hist.gn     = nan(K,1);
    hist.step   = nan(K,1);
    hist.mu     = nan(K,1);
    hist.iters  = K;
    hist.conv   = false;
    hist.status = 'MAX_ITER';
    hist.x_final = [];
end

function hist = trim_hist(hist, k, status)
    Kf          = max(2,k);
    hist.J      = hist.J(1:Kf);
    hist.E      = hist.E(1:Kf);
    hist.gn     = hist.gn(1:Kf);
    hist.step   = hist.step(1:Kf);
    hist.mu     = hist.mu(1:Kf);
    hist.iters  = k;
    hist.status = status;
end

function hist = audit_general(hist, x, z, meas, Ybus, Yf, mpc, n, nm, Rd, ...
        rmseV, rmseA, tol_g, tol_dx, rmse_lim, name)
    [~,~,Jf,gf,Gf] = compute_all_general(x, z, meas, Ybus, Yf, mpc, n, nm, Rd);
    gn_f = sgi_general(gf, Gf);
    d    = max(abs(diag(Gf)), 1e-14);
    dxf  = norm(gf ./ d, inf);
    hist.J_final  = Jf;
    hist.gn_final = gn_f;
    hist.dx_final = dxf;
    hist.rmseV    = rmseV;
    hist.rmseA    = rmseA;

    g_ok    = isfinite(gn_f) && gn_f <= tol_g;
    dx_ok   = isfinite(dxf) && dxf  <= tol_dx;
    last_step = NaN;
    if isfield(hist,'step') && ~isempty(hist.step)
        v = hist.step(isfinite(hist.step));
        if ~isempty(v), last_step = v(end); end
    end
    step_ok = isfinite(last_step) && last_step <= tol_dx;

    if ~isfinite(rmseV) || rmseV > rmse_lim
        hist.conv   = false;
        hist.status = 'FALSE_CONV_HIGH_RMSE';
    elseif ~isfinite(Jf) || ~isfinite(gn_f)
        hist.conv   = false;
        hist.status = 'DIVERGED';
    elseif (g_ok || dx_ok || step_ok)
        hist.conv   = true;
        hist.status = 'TRUE_CONV';
    elseif ~isfinite(Jf)
        hist.conv   = false;
        hist.status = 'NOT_CONVERGED';
    else
        hist.conv   = false;
        hist.status = 'NOT_CONVERGED';
    end
    hist.audit_method = name;
end

function [Ybus, Yf] = build_Ybus_general(mpc, n)
    nb_  = size(mpc.branch,1);
    Ybus = sparse(n,n);
    Yf   = zeros(nb_,n);
    for k = 1:nb_
        f   = max(1, min(n, round(mpc.branch(k,1))));
        t   = max(1, min(n, round(mpc.branch(k,2))));
        r   = mpc.branch(k,3);
        x   = mpc.branch(k,4);
        bsh = mpc.branch(k,5);
        tap = mpc.branch(k,6);

        den = r^2 + x^2;
        if den < 1e-12
            ys = 1e6 * (1 - 1i*0);
        else
            ys = (r - 1i*x) / den;
        end

        yff = (ys + 1i*bsh/2) / (tap^2);
        yft = -ys / tap;
        ytf = -ys / tap;
        ytt =  ys + 1i*bsh/2;

        Ybus(f,f) = Ybus(f,f) + yff;
        Ybus(f,t) = Ybus(f,t) + yft;
        Ybus(t,f) = Ybus(t,f) + ytf;
        Ybus(t,t) = Ybus(t,t) + ytt;
        Yf(k,f) = yff;
        Yf(k,t) = yft;
    end
    Yf = sparse(Yf);
end

function [theta, Vmag, pf_ok] = run_pf_robust(mpc, Ybus, n, sl)
    bt   = mpc.bus(:,2);
    Psch = mpc.bus(:,5) - mpc.bus(:,3);
    Qsch = mpc.bus(:,6) - mpc.bus(:,4);
    pv   = find(bt==2);
    pq   = find(bt==3);
    thf  = setdiff((1:n)',sl);
    vi   = pq;
    theta = zeros(n,1);
    Vmag  = mpc.bus(:,7);
    pf_ok = false;
    if any(Vmag<0.5|Vmag>1.5|~isfinite(Vmag)), Vmag=ones(n,1); end
    for gamma = 0.2:0.2:1.0
        Ps = gamma*Psch; Qs = gamma*Qsch;
        for it = 1:300
            V    = Vmag.*exp(1i*theta);
            Sinj = V.*conj(Ybus*V);
            mis  = [Ps(thf)-real(Sinj(thf)); Qs(vi)-imag(Sinj(vi))];
            if norm(mis,inf)<1e-7
                if gamma>=0.99
                    pf_ok = true;
                    theta = theta-theta(sl);
                    return;
                else
                    break;
                end
            end
            J = pf_jac_general(Vmag,theta,Ybus,n,thf,vi);
            if isempty(J)||any(~isfinite(J(:))), break; end
            if rcond(full(J))<1e-12
                J=J+1e-5*eye(size(J))*max(1,trace(abs(J))/size(J,1));
            end
            dx = J\mis; dx(~isfinite(dx))=0;
            if norm(dx,inf)>0.15, dx=dx*(0.15/norm(dx,inf)); end
            nt=numel(thf);
            theta(thf)=theta(thf)+dx(1:nt);
            Vmag(vi)  =Vmag(vi)+dx(nt+1:end);
            Vmag(pv)  =mpc.bus(pv,7);
            Vmag=max(0.5,min(1.5,Vmag));
        end
        if pf_ok, break; end
    end
    theta=theta-theta(sl);
end

function J = pf_jac_general(Vmag,theta,Ybus,n,thi,vi)
    V    = Vmag.*exp(1i*theta);
    I    = Ybus*V;
    dV   = diag(V);
    dI   = diag(I);
    dVn  = diag(V./max(abs(V),1e-9));
    dSth = 1i*dV*conj(dI-Ybus*dV);
    dSV  = dV*conj(Ybus*dVn)+dI*conj(dVn);
    J    = [real(dSth(thi,thi)),real(dSV(thi,vi));
            imag(dSth(vi,thi)), imag(dSV(vi,vi))];
    J(~isfinite(J))=0;
end

function pb = get_pmu_buses(num, n)
    switch num
        case 11, pb = [1 4 8];
        case 13, pb = [1 6 8];
        case 20, pb = [1 17 20];
        case 14, pb = [1 6 9];
        case 57, pb = round(linspace(1, n, 10));
        otherwise, pb = [1 round(n/2) n];
    end
    pb = pb(pb >= 1 & pb <= n);
end

