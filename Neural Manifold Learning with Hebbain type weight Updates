
function illcond_SE_v36()

    clc; close all; rng(42);

    % ===== MATPOWER PATH =====
    matpower_path = 'D:\Asjad\Masters\Masters Thesis\MATPOWER\matpower8.0';
    if exist(matpower_path, 'dir')
        addpath(genpath(matpower_path));
        rehash path;
        use_matpower = true;
    else
        fprintf('  [WARN] MATPOWER not found. Using built-in data.\n');
        use_matpower = false;
    end

    measMode    = 'HYBRID';
    methodNames = {'WLS-Std', 'WLS-Mod (LM)', 'DMHN'};
    colors      = {[0 0 0], [0 0.45 0.74], [0.85 0.33 0.10]};
    lineStyles  = {'-', '--', '-.'};
    markers     = {'s', '^', 'o'};
    nMethods    = 3;

    sysNums  = [11, 13, 20, 14, 57];
    sysNames = {'11-bus', '13-bus', '20-bus', 'IEEE 14-bus', 'IEEE 57-bus'};
    nSys     = 5;

    tol_grad = 1e-6;
    tol_dx   = 1e-6;
    rmse_lim = 1e-1;

    SEP  = repmat('=', 1, 100);
    SEP2 = repmat('-', 1, 100);
    fprintf('\n%s\n  POWER SYSTEM STATE ESTIMATION – v36 (MAX_ITER=400)\n%s\n\n', SEP, SEP);

    all_hists   = cell(nSys, nMethods);
    all_rmseV   = zeros(nSys, nMethods);
    all_rmseA   = zeros(nSys, nMethods);
    all_conv    = false(nSys, nMethods);
    all_x_final = cell(nSys, nMethods);
    sys_data    = cell(nSys, 1);

    true_Vm_all = cell(nSys, 1);
    true_Th_all = cell(nSys, 1);

    %======================================================================
    %  BUILD SYSTEMS
    %======================================================================
    fprintf('  BUILDING TEST SYSTEMS\n%s\n', SEP2);

    for si = 1:nSys
        num = sysNums(si);

        if num == 14
            mpc = build_ieee14_mpc();
        elseif num == 57 && use_matpower
            mpc = build_from_matpower('case57');
        elseif num == 57
            mpc = build_ieee57_mpc();
        else
            mpc = build_mpc(num);
        end

        n  = mpc.n;
        nb = size(mpc.branch, 1);
        pb = get_pmu_buses(num, n);
        [Ybus, Yf] = build_Ybus_general(mpc, n);

        sl = find(mpc.bus(:,2) == 1);
        if isempty(sl), sl = 1; end

        [th_true, Vm_true, pf_ok] = run_pf_robust(mpc, Ybus, n, sl);

        if pf_ok
            fprintf('  ✓ %s: PF CONVERGED\n', sysNames{si});
        else
            fprintf('  ⚠ %s: PF FAILED - using FLAT START\n', sysNames{si});
            th_true = zeros(n, 1);
            Vm_true = ones(n, 1);
        end

        true_Vm_all{si} = Vm_true;
        true_Th_all{si} = th_true;

        fprintf('      Vm_true (first 5):'); fprintf(' %.4f', Vm_true(1:min(5,n))); fprintf('\n');
        fprintf('      Th_true (first 5):'); fprintf(' %.2f', th_true(1:min(5,n))*180/pi); fprintf(' deg\n');

        [z_true, meas] = build_meas_general(mpc, Ybus, Yf, th_true, Vm_true, n, nb, pb, measMode, num);
        rng(42);
        z    = z_true + meas.sigma .* randn(size(z_true));
        Rinv = diag(1 ./ meas.sigma.^2);
        Rd   = diag(Rinv);
        nm   = numel(z);
        Nst  = 2*n - 1;
        dof  = max(nm - Nst, 1);

        x0 = [zeros(n-1, 1); ones(n, 1)];
        x0 = clip_x(x0, n);

        H0       = jac_H_general(x0, meas, Ybus, Yf, mpc, n, nm);
        kappaHWH = cond(H0' * Rinv * H0);

        fprintf('      n=%d, nm=%d, dof=%d, κ(HWH)=%.2e\n\n', ...
            n, nm, dof, kappaHWH);

        d.mpc = mpc; d.n = n; d.nb = nb; d.Ybus = Ybus; d.Yf = Yf;
        d.th_true = th_true; d.Vm_true = Vm_true;
        d.z = z; d.meas = meas; d.Rd = Rd; d.nm = nm; d.x0 = x0;
        d.kappaHWH = kappaHWH; d.dof = dof; d.pf_ok = pf_ok;
        sys_data{si} = d;
    end

    %======================================================================
    %  RUN STATE ESTIMATION
    %======================================================================
    fprintf('%s\n  RUNNING STATE ESTIMATION (tol_grad = %.0e, tol_dx = %.0e)\n%s\n', ...
        SEP, tol_grad, tol_dx, SEP2);

    for si = 1:nSys
        d = sys_data{si};
        n = d.n; Ybus = d.Ybus; Yf = d.Yf; mpc = d.mpc;
        z = d.z; meas = d.meas; Rd = d.Rd; nm = d.nm; x0 = d.x0;
        Vm_true = d.Vm_true; th_true = d.th_true;

        fprintf('\n[%s] (κ=%.2e)\n', sysNames{si}, d.kappaHWH);
        fprintf('%-12s %8s %6s %10s %10s %10s %8s\n', ...
            'Method','Conv','Iter','RMSE_V','RMSE_Th','J(x)','Time(s)');

        p1 = struct('MAX_ITER', 150, 'tol', tol_grad, 'tol_dx', tol_dx, ...
                    'kappa', d.kappaHWH);
        t0 = tic;
        [x1, h1] = se_wls_correct(z, meas, Ybus, Yf, mpc, n, nm, Rd, x0, p1);
        t1 = toc(t0);
        [rv1, ra1] = rmse_state_full(x1, Vm_true, th_true, n);
        h1 = audit_general(h1, x1, z, meas, Ybus, Yf, mpc, n, nm, Rd, ...
            rv1, ra1, tol_grad, tol_dx, rmse_lim, 'WLS-Std');

        p2 = struct('MAX_ITER', 200, 'tol', tol_grad, 'tol_dx', tol_dx, ...
                    'kappa', d.kappaHWH);
        t0 = tic;
        [x2, h2] = se_wls_lm_correct(z, meas, Ybus, Yf, mpc, n, nm, Rd, x0, p2);
        t2 = toc(t0);
        [rv2, ra2] = rmse_state_full(x2, Vm_true, th_true, n);
        h2 = audit_general(h2, x2, z, meas, Ybus, Yf, mpc, n, nm, Rd, ...
            rv2, ra2, tol_grad, tol_dx, rmse_lim, 'WLS-Mod');

        p3 = build_dmhn_params(d.kappaHWH, n, tol_grad, tol_dx);
        t0 = tic;
        [x3, h3] = se_dmhn_adaptive_natural_stop(z, meas, Ybus, Yf, mpc, n, nm, Rd, x0, p3);
        t3 = toc(t0);
        [rv3, ra3] = rmse_state_full(x3, Vm_true, th_true, n);
        h3 = audit_general(h3, x3, z, meas, Ybus, Yf, mpc, n, nm, Rd, ...
            rv3, ra3, tol_grad, tol_dx, rmse_lim, 'DMHN');

        hs  = {h1, h2, h3};
        rsV = [rv1, rv2, rv3];
        rsA = [ra1, ra2, ra3];
        ts  = [t1, t2, t3];

        for mi = 1:nMethods
            all_hists{si, mi}   = hs{mi};
            all_rmseV(si, mi)   = rsV(mi);
            all_rmseA(si, mi)   = rsA(mi);
            all_conv(si, mi)    = hs{mi}.conv;
            all_x_final{si, mi} = hs{mi}.x_final;

            cs = sprintf('%d', hs{mi}.conv);
            if hs{mi}.conv, cs = ['✓' cs]; else, cs = ['✗' cs]; end

            fprintf('%-12s %8s %6d %10.2e %10.2e %10.2f %8.3f [%s]\n', ...
                methodNames{mi}, cs, hs{mi}.iters, rsV(mi), rsA(mi)*180/pi, ...
                hs{mi}.J_final, ts(mi), hs{mi}.status);
        end
    end

    %======================================================================
    %  HYPERPARAMETER SENSITIVITY ANALYSIS (13-BUS AND 57-BUS)
    %======================================================================
    fprintf('\n%s\n  HYPERPARAMETER SENSITIVITY ANALYSIS (13-BUS AND 57-BUS, MAX_ITER=400)\n%s\n', SEP, SEP2);
    fprintf('  Running 5x5 sweep for 13-bus and IEEE 57-bus systems\n');
    fprintf('  This may take several minutes...\n\n');

    % Run for 13-bus (index 2) and 57-bus (index 5)
    sensitivity_results = run_sensitivity_analysis(sys_data, [2, 5], sysNames);

    %======================================================================
    %  SAVE SENSITIVITY RESULTS
    %======================================================================
    save('sensitivity_results.mat', 'sensitivity_results');
    fprintf('  Sensitivity results saved to sensitivity_results.mat\n');

    %======================================================================
    %  GENERATE SENSITIVITY FIGURES
    %======================================================================
    fig_sensitivity_heatmaps(sensitivity_results, sysNames);
    fig_sensitivity_iterations(sensitivity_results, sysNames);
    fig_sensitivity_runtime(sensitivity_results, sysNames);
    fig_sensitivity_rmse(sensitivity_results, sysNames);

    %======================================================================
    %  FIGURES
    %======================================================================
    fprintf('\n%s\n  GENERATING FIGURES\n%s\n', SEP, SEP2);

    fig_energy_all_systems_DMHN_only(all_hists, sysNames, methodNames, colors, lineStyles);
    fig_combined_gradient(all_hists, sysNames, methodNames, colors, lineStyles, tol_grad);
    fig_combined_step(all_hists, sysNames, methodNames, colors, lineStyles, tol_dx);
    fig_rmse_bars(all_rmseV, all_rmseA, sysNames, methodNames);
    fig_bus_errors_voltage(all_x_final, true_Vm_all, sysNames, methodNames, colors, markers);
    fig_bus_errors_angle(all_x_final, true_Th_all, sysNames, methodNames, colors, markers);

    %======================================================================
    %  SUMMARY TABLE
    %======================================================================
    fprintf('\n%s\n  FINAL SUMMARY\n%s\n', SEP, SEP);
    fprintf('┌────────────────┬──────────────────┬────────────┬────────────┬─────────────┬────────────┐\n');
    fprintf('│ System         │ Method           │ Converged  │ RMSE_V     │ RMSE_Th(deg)│ Iterations │\n');
    fprintf('├────────────────┼──────────────────┼────────────┼────────────┼─────────────┼────────────┤\n');

    for si = 1:nSys
        for mi = 1:nMethods
            cs = '✓ YES'; if ~all_conv(si,mi), cs = '✗ NO '; end
            fprintf('│ %-14s │ %-16s │ %-10s │ %10.3e │ %11.3e │ %10d │\n', ...
                sysNames{si}, methodNames{mi}, cs, ...
                all_rmseV(si,mi), all_rmseA(si,mi)*180/pi, all_hists{si,mi}.iters);
        end
        if si < nSys
            fprintf('├────────────────┼──────────────────┼────────────┼────────────┼─────────────┼────────────┤\n');
        end
    end
    fprintf('└────────────────┴──────────────────┴────────────┴────────────┴─────────────┴────────────┘\n');
    fprintf('\n%s\n  DONE\n%s\n', SEP, SEP);
end

%==========================================================================
%  BUILD DMHN PARAMETERS - MODIFIED FOR 400 ITERATIONS
%==========================================================================
function p = build_dmhn_params(kHWH, n, tol_g, tol_dx)
    p.MAX_ITER = 400;
    p.chi2     = 0;
    p.tol_grad = tol_g;
    p.tol_dx   = tol_dx;
    p.mu0      = min(1.0, 1e-3 * max(1, log10(kHWH)));
    p.mu_max   = 1e10;
    p.eta_rej  = 1e-4;
    p.max_ls   = 30;
    p.svd_tol  = 1e-10;

    p.max_angle_step = 0.05;
    p.max_volt_step  = 0.025;

    p.phi_scale     = 0.8;
    p.wd_scale      = 0.3;
    p.wd_diag_scale = 0.5;
    p.id_scale      = 1.5;
    p.eta_A         = 0.05;
    p.eta_Wi        = 0.02;
    p.A_init        = 0.05;
    p.Wi_init       = 0.01;
    p.A_max         = 15.0;
    p.Wi_max        = 8.0;
    
    p.forgetting    = 0.01;
    p.alpha_WD_scale = 1.0;
    p.alpha_ID_scale = 1.0;

    if kHWH > 1e3
        p.wd_scale      = 0.8;
        p.wd_diag_scale = 1.2;
        p.eta_A         = 0.10;
        p.eta_Wi        = 0.04;
        p.id_scale      = 2.0;
        p.mu0           = 0.5;
        p.forgetting    = 0.02;
    end
end

%==========================================================================
%  SENSITIVITY ANALYSIS FUNCTION
%==========================================================================
function results = run_sensitivity_analysis(sys_data, system_indices, sysNames)
    % Run 5x5 sweep for specified systems
    % alpha_WD = [0.25, 0.5, 1.0, 2.0, 4.0]
    % alpha_ID = [0.25, 0.5, 1.0, 2.0, 4.0]
    
    alpha_values = [0.25, 0.5, 1.0, 2.0, 4.0];
    n_alphas = length(alpha_values);
    
    results = struct();
    results.systems = {};
    results.alpha_WD = alpha_values;
    results.alpha_ID = alpha_values;
    results.RMSE_V = [];
    results.RMSE_A = [];
    results.J_final = [];
    results.iterations = [];
    results.time = [];
    results.converged = [];
    
    for sys_idx = 1:length(system_indices)
        si = system_indices(sys_idx);
        d = sys_data{si};
        sysName = sysNames{si};
        
        fprintf('  Running sweep for %s...\n', sysName);
        fprintf('  WD\\ID');
        for ai = 1:n_alphas
            fprintf('  %6.2f', alpha_values(ai));
        end
        fprintf('\n');
        
        RMSE_V_mat = zeros(n_alphas, n_alphas);
        RMSE_A_mat = zeros(n_alphas, n_alphas);
        J_mat = zeros(n_alphas, n_alphas);
        iter_mat = zeros(n_alphas, n_alphas);
        time_mat = zeros(n_alphas, n_alphas);
        conv_mat = false(n_alphas, n_alphas);
        
        for wi = 1:n_alphas
            fprintf('  %6.2f', alpha_values(wi));
            for ii = 1:n_alphas
                alpha_WD = alpha_values(wi);
                alpha_ID = alpha_values(ii);
                
                p = build_dmhn_params(d.kappaHWH, d.n, 1e-6, 1e-6);
                p.alpha_WD_scale = alpha_WD;
                p.alpha_ID_scale = alpha_ID;
                p.MAX_ITER = 400;
                
                try
                    t0 = tic;
                    [x, h] = se_dmhn_with_scaled_params(d.z, d.meas, d.Ybus, d.Yf, ...
                        d.mpc, d.n, d.nm, d.Rd, d.x0, p);
                    t = toc(t0);
                    
                    [rv, ra] = rmse_state_full(x, d.Vm_true, d.th_true, d.n);
                    
                    RMSE_V_mat(wi, ii) = rv;
                    RMSE_A_mat(wi, ii) = ra;
                    J_mat(wi, ii) = h.J_final;
                    iter_mat(wi, ii) = h.iters;
                    time_mat(wi, ii) = t;
                    conv_mat(wi, ii) = h.conv;
                    
                    fprintf('  %6.2f', iter_mat(wi, ii));
                catch ME
                    fprintf('  %6s', 'FAIL');
                    % Surface the real error instead of silently discarding it.
                    fprintf('\n    [alpha_WD=%.2f, alpha_ID=%.2f] %s: %s\n', ...
                        alpha_WD, alpha_ID, ME.identifier, ME.message);
                    for kk = 1:numel(ME.stack)
                        fprintf('      at %s (line %d)\n', ME.stack(kk).name, ME.stack(kk).line);
                    end
                    RMSE_V_mat(wi, ii) = NaN;
                    RMSE_A_mat(wi, ii) = NaN;
                    J_mat(wi, ii) = NaN;
                    iter_mat(wi, ii) = NaN;
                    time_mat(wi, ii) = NaN;
                    conv_mat(wi, ii) = false;
                end
            end
            fprintf('\n');
        end
        
        results.systems{end+1} = sysName;
        results.RMSE_V = cat(3, results.RMSE_V, RMSE_V_mat);
        results.RMSE_A = cat(3, results.RMSE_A, RMSE_A_mat);
        results.J_final = cat(3, results.J_final, J_mat);
        results.iterations = cat(3, results.iterations, iter_mat);
        results.time = cat(3, results.time, time_mat);
        results.converged = cat(3, results.converged, conv_mat);
        
        fprintf('  Completed sweep for %s\n\n', sysName);
    end
end

%==========================================================================
%  DMHN WITH SCALED PARAMETERS
%==========================================================================
function [x, hist] = se_dmhn_with_scaled_params(z, meas, Ybus, Yf, mpc, n, nm, Rd, x0, par)
    Nst  = 2*n - 1;
    x    = clip_x(x0, n);
    K    = par.MAX_ITER;
    hist = init_hist(K);
    hist.x_final = x;

    tol_g  = par.tol_grad;
    tol_dx = par.tol_dx;

    x_best = x;
    J_best = inf;
    mu     = par.mu0;
    nu     = 2.0;

    sigma_mean = mean(1 ./ sqrt(max(diag(diag(Rd)), 1e-12)));
    ds = dmhn_init_general(Nst, par);
    dt = 0.20;
    
    [~, ~, ~, g0, ~] = compute_all_general(x, z, meas, Ybus, Yf, mpc, n, nm, Rd);
    g0_norm = max(norm(g0), 1e-12);
    
    lambda = par.forgetting;
    
    WD_prev = zeros(Nst);
    ID_prev = zeros(Nst, 1);
    x_prev = x;
    
    tol_state = 1e-6;
    tol_WD = 1e-5;
    tol_ID = 1e-5;
    
    alpha_WD_scale = par.alpha_WD_scale;
    alpha_ID_scale = par.alpha_ID_scale;

    for k = 1:K
        x = clip_x(x, n);
        [r, H, J_t, g, G] = compute_all_general(x, z, meas, Ybus, Yf, mpc, n, nm, Rd);
        gn_v = sgi_general(g, G);
        g_norm = norm(g);

        hist.J(k)  = J_t;
        hist.gn(k) = gn_v;
        hist.mu(k) = mu;

        if J_t < J_best
            J_best = J_t;
            x_best = x;
        end

        alpha = min(1.0, g_norm / g0_norm);
        
        [Q_eff, g_eff, WD, ID, ds] = dmhn_effective_system_adaptive_scaled(...
            G, g, r, sigma_mean, x, n, ds, par, alpha, lambda, alpha_WD_scale, alpha_ID_scale);
        
        g_nrm = max(g_norm, 1e-8);
        phi = tanh(g / g_nrm);
        E_D = 0.5 * phi' * WD * phi;
        E_I = phi' * ds.Wi * phi;
        E_total = J_t + real(E_D) + real(E_I);
        hist.E(k) = E_total;
        
        state_change = norm(x - x_prev, inf) / max(norm(x, inf), 1e-12);
        x_prev = x;
        WD_change = norm(WD - WD_prev, 'fro') / max(norm(WD_prev, 'fro'), 1e-12);
        WD_prev = WD;
        ID_change = norm(ID - ID_prev) / max(norm(ID_prev), 1e-12);
        ID_prev = ID;
        hist.step(k) = state_change;
        
        if state_change < tol_state && WD_change < tol_WD && ID_change < tol_ID
            hist = trim_hist(hist, k, 'NATURAL_CONV');
            hist.conv    = true;
            hist.x_final = x_best;
            hist.J_final = J_best;
            x = x_best;
            return;
        end

        diagQ = max(abs(diag(Q_eff)), 1e-14);
        Q_lm  = Q_eff + mu * diag(diagQ);
        Q_lm  = 0.5*(Q_lm + Q_lm');

        [Qp, Ds] = struct_precond_general(Q_lm);
        dp = solve_svd_general(Qp, Ds .* g_eff, par.svd_tol);
        d  = Ds .* dp;
        d(~isfinite(d)) = 0;
        d  = clip_step_general(d, n, par);

        gTd = g_eff' * d;
        if ~isfinite(gTd) || gTd >= 0
            d   = -g_eff;
            d   = clip_step_general(d, n, par);
            gTd = g_eff' * d;
            if gTd >= 0, d = zeros(Nst,1); end
        end

        alpha_step = 1.0;
        accepted  = false;
        rho_k     = -inf;
        pred_full = -g_eff'*d - 0.5*(d'*Q_lm*d);
        if ~isfinite(pred_full) || pred_full <= 0
            pred_full = 1e-4 * max(-gTd, 1e-12);
        end

        for ls = 1:par.max_ls
            xt = clip_x(x + alpha_step*dt*d, n);
            [~,~,Jt,~,~] = compute_all_general(xt, z, meas, Ybus, Yf, mpc, n, nm, Rd);
            act   = J_t - Jt;
            rho_k = act / max(alpha_step*dt*pred_full, 1e-18);
            if isfinite(Jt) && act > 0 && rho_k > par.eta_rej
                accepted = true;
                break;
            end
            alpha_step = alpha_step * 0.5;
            if alpha_step < 1e-14, break; end
        end

        if accepted
            hist.step(k) = norm(alpha_step*dt*d, inf);
            x    = clip_x(x + alpha_step*dt*d, n);
            mu   = mu * max(1/3, 1-(2*rho_k-1)^3);
            nu   = 2.0;
        else
            hist.step(k) = 0;
            mu = min(par.mu_max, mu*nu);
            nu = 2*nu;
        end
    end
    
    x    = x_best;
    hist = trim_hist(hist, K, 'MAX_ITER');
    hist.x_final = x;
    hist.J_final = J_best;

    [~,~,Jf,gf,Gf] = compute_all_general(x, z, meas, Ybus, Yf, mpc, n, nm, Rd);
    if Jf <= par.chi2 && sgi_general(gf,Gf) <= tol_g
        hist.conv   = true;
        hist.status = 'TRUE_CONV';
    end
end

%==========================================================================
%  DMHN EFFECTIVE SYSTEM WITH SCALED PARAMETERS
%==========================================================================
function [Q_eff, g_eff, WD, ID, dmhn_state] = dmhn_effective_system_adaptive_scaled(...
        G, g, r, sigma_mean, x, n, dmhn_state, par, alpha, lambda, alpha_WD_scale, alpha_ID_scale)

    Nst  = numel(g);
    g_nrm = max(norm(g), 1e-8);
    u_c   = g / g_nrm;
    T_leak = sqrt(max(abs(diag(G)), 1e-14));
    phi_uc = tanh(u_c / par.phi_scale);

    A    = dmhn_state.A;
    Wi   = dmhn_state.Wi;
    
    A_new = (1 - lambda) * A + par.eta_A * (phi_uc * u_c');
    Wi_new = (1 - lambda) * Wi + par.eta_Wi * (phi_uc * phi_uc');
    
    nA = norm(A_new,'fro');
    if nA > par.A_max,  A_new = A_new * (par.A_max/nA);  end
    nW = norm(Wi_new,'fro');
    if nW > par.Wi_max, Wi_new = Wi_new * (par.Wi_max/nW); end
    
    dmhn_state.A = A_new;
    dmhn_state.Wi = Wi_new;
    
    Au = A_new * phi_uc;
    scale_wd = par.wd_scale * (1 + log1p(g_nrm));
    WD_raw = (Au * Au') * scale_wd + diag(T_leak) * par.wd_diag_scale;
    
    WD = alpha * alpha_WD_scale * WD_raw;
    ID = alpha * alpha_ID_scale * Wi_new * phi_uc * par.id_scale;

    Q_eff = G + WD;
    Q_eff = 0.5*(Q_eff + Q_eff');
    g_eff = g - ID;
end

%==========================================================================
%  DMHN ADAPTIVE NATURAL STOP (MAIN DMHN FUNCTION)
%==========================================================================
function [x, hist] = se_dmhn_adaptive_natural_stop(z, meas, Ybus, Yf, mpc, n, nm, Rd, x0, par)
    Nst  = 2*n - 1;
    x    = clip_x(x0, n);
    K    = par.MAX_ITER;
    hist = init_hist(K);
    hist.x_final = x;

    tol_g  = par.tol_grad;
    tol_dx = par.tol_dx;

    x_best = x;
    J_best = inf;
    mu     = par.mu0;
    nu     = 2.0;

    sigma_mean = mean(1 ./ sqrt(max(diag(diag(Rd)), 1e-12)));
    ds = dmhn_init_general(Nst, par);
    dt = 0.20;
    
    [~, ~, ~, g0, ~] = compute_all_general(x, z, meas, Ybus, Yf, mpc, n, nm, Rd);
    g0_norm = max(norm(g0), 1e-12);
    
    lambda = par.forgetting;
    
    WD_prev = zeros(Nst);
    ID_prev = zeros(Nst, 1);
    x_prev = x;
    
    tol_state = 1e-6;
    tol_WD = 1e-5;
    tol_ID = 1e-5;
    
    if ~isfield(par, 'alpha_WD_scale')
        par.alpha_WD_scale = 1.0;
    end
    if ~isfield(par, 'alpha_ID_scale')
        par.alpha_ID_scale = 1.0;
    end

    for k = 1:K
        x = clip_x(x, n);
        [r, H, J_t, g, G] = compute_all_general(x, z, meas, Ybus, Yf, mpc, n, nm, Rd);
        gn_v = sgi_general(g, G);
        g_norm = norm(g);

        hist.J(k)  = J_t;
        hist.gn(k) = gn_v;
        hist.mu(k) = mu;

        if J_t < J_best
            J_best = J_t;
            x_best = x;
        end

        alpha = min(1.0, g_norm / g0_norm);
        
        [Q_eff, g_eff, WD, ID, ds] = dmhn_effective_system_adaptive_scaled(...
            G, g, r, sigma_mean, x, n, ds, par, alpha, lambda, ...
            par.alpha_WD_scale, par.alpha_ID_scale);
        
        g_nrm = max(g_norm, 1e-8);
        phi = tanh(g / g_nrm);
        E_D = 0.5 * phi' * WD * phi;
        E_I = phi' * ds.Wi * phi;
        E_total = J_t + real(E_D) + real(E_I);
        hist.E(k) = E_total;
        
        state_change = norm(x - x_prev, inf) / max(norm(x, inf), 1e-12);
        x_prev = x;
        WD_change = norm(WD - WD_prev, 'fro') / max(norm(WD_prev, 'fro'), 1e-12);
        WD_prev = WD;
        ID_change = norm(ID - ID_prev) / max(norm(ID_prev), 1e-12);
        ID_prev = ID;
        hist.step(k) = state_change;
        
        if state_change < tol_state && WD_change < tol_WD && ID_change < tol_ID
            hist = trim_hist(hist, k, 'NATURAL_CONV');
            hist.conv    = true;
            hist.x_final = x_best;
            x = x_best;
            return;
        end

        diagQ = max(abs(diag(Q_eff)), 1e-14);
        Q_lm  = Q_eff + mu * diag(diagQ);
        Q_lm  = 0.5*(Q_lm + Q_lm');

        [Qp, Ds] = struct_precond_general(Q_lm);
        dp = solve_svd_general(Qp, Ds .* g_eff, par.svd_tol);
        d  = Ds .* dp;
        d(~isfinite(d)) = 0;
        d  = clip_step_general(d, n, par);

        gTd = g_eff' * d;
        if ~isfinite(gTd) || gTd >= 0
            d   = -g_eff;
            d   = clip_step_general(d, n, par);
            gTd = g_eff' * d;
            if gTd >= 0, d = zeros(Nst,1); end
        end

        alpha_step = 1.0;
        accepted  = false;
        rho_k     = -inf;
        pred_full = -g_eff'*d - 0.5*(d'*Q_lm*d);
        if ~isfinite(pred_full) || pred_full <= 0
            pred_full = 1e-4 * max(-gTd, 1e-12);
        end

        for ls = 1:par.max_ls
            xt = clip_x(x + alpha_step*dt*d, n);
            [~,~,Jt,~,~] = compute_all_general(xt, z, meas, Ybus, Yf, mpc, n, nm, Rd);
            act   = J_t - Jt;
            rho_k = act / max(alpha_step*dt*pred_full, 1e-18);
            if isfinite(Jt) && act > 0 && rho_k > par.eta_rej
                accepted = true;
                break;
            end
            alpha_step = alpha_step * 0.5;
            if alpha_step < 1e-14, break; end
        end

        if accepted
            hist.step(k) = norm(alpha_step*dt*d, inf);
            x    = clip_x(x + alpha_step*dt*d, n);
            mu   = mu * max(1/3, 1-(2*rho_k-1)^3);
            nu   = 2.0;
        else
            hist.step(k) = 0;
            mu = min(par.mu_max, mu*nu);
            nu = 2*nu;
        end
    end
    
    x    = x_best;
    hist = trim_hist(hist, K, 'MAX_ITER');
    hist.x_final = x;

    [~,~,Jf,gf,Gf] = compute_all_general(x, z, meas, Ybus, Yf, mpc, n, nm, Rd);
    if Jf <= par.chi2 && sgi_general(gf,Gf) <= tol_g
        hist.conv   = true;
        hist.status = 'TRUE_CONV';
    end
end

%==========================================================================
%  DMHN INITIALIZATION
%==========================================================================
function ds = dmhn_init_general(Nst, par)
    ds.A  = eye(Nst) * par.A_init;
    ds.Wi = eye(Nst) * par.Wi_init;
end

