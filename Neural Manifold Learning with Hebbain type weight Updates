    [nr, nc] = subplot_grid(length(sysNames));
    subplot_labels = subplot_label_set(length(sysNames));
    
    for si = 1:length(sysNames)
        ax = subplot(nr,nc,si);
        hold(ax,'on'); box(ax,'on');
        
        mi = 3;
